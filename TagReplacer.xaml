<Window x:Class="Send_Whatsapp.TagReplacer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag Replacer" Height="450" Width="950" Background="Black">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Input Section -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <Label Content="Tag:" Width="50" VerticalAlignment="Center" Foreground="White"/>
            <TextBox x:Name="txtTag" Width="200" Margin="0,0,10,0" Foreground="White" Background="Black"/>

            <Label Content="Content:" Width="70" VerticalAlignment="Center" Foreground="White"/>
            <TextBox x:Name="txtContent" Width="300" Margin="0,0,10,0" Background="Black" Foreground="white"/>

            <Button Content="Add" Width="80" Margin="0,0,10,0" Click="BtnAdd_Click" Background="black" Foreground="white"/>
            <Button Content="Update" Width="80" Margin="0,0,10,0" Click="BtnUpdate_Click" Background="black" Foreground="white"/>
            <Button Content="Delete" Width="80" Click="BtnDelete_Click" Background="black" Foreground="white"/>
        </StackPanel>

        <!-- DataGrid Section -->
        <DataGrid x:Name="dataGridTags" Grid.Row="1" AutoGenerateColumns="False" HeadersVisibility="Column" Background="black" BorderBrush="white"
                  CanUserAddRows="False" SelectionMode="Single" SelectionChanged="DataGridTags_SelectionChanged">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <!-- Set the background and foreground color for the header -->
                    <Setter Property="Background" Value="#141821"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <!-- Set background color for all rows -->
                    <Setter Property="Background" Value="Black" />
                    <Setter Property="Foreground" Value="White" />

                    <!-- Define selected row styling -->
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <!-- Set border color for selected row -->
                            <Setter Property="BorderBrush" Value="#364259" />
                            <Setter Property="BorderThickness" Value="0" />
                            <!-- Optionally change background of the selected row -->
                            <Setter Property="Background" Value="black" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="200"/>
                <DataGridTextColumn Header="Content" Binding="{Binding Content}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
